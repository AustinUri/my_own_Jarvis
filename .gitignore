# If you want to keep the folder structure but not the heavy files,
# uncomment these instead of ignoring the whole folder:
# third_party/whisper.cpp/*
# !third_party/whisper.cpp/models/
# !third_party/whisper.cpp/.gitkeep
# !third_party/whisper.cpp/models/.gitkeep

