<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061018"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J.A.R.V.I.S. MOBILE"
            android:textColor="#8FEFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="V30 · Oracle Cloud Companion"
            android:textColor="#A7BBC8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="JARVIS CLOUD"
            android:textColor="#8FEFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cloudAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="https://uri-jarvis.duckdns.org"
            android:textColor="#D9F7FF"
            android:textIsSelectable="true" />

        <EditText
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="6-digit cloud pairing code"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#EAFBFF"
            android:textColorHint="#68808F" />

        <Button
            android:id="@+id/testConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="TEST JARVIS CLOUD" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PAIR WITH JARVIS CLOUD" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="START CLOUD LINK" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="REMOTE JARVIS"
            android:textColor="#FFCC78"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/askText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:maxLines="5"
            android:gravity="top"
            android:hint="Ask JARVIS from your phone…"
            android:inputType="textMultiLine"
            android:textColor="#EAFBFF"
            android:textColorHint="#68808F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/askButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ASK JARVIS" />

            <Button
                android:id="@+id/voiceAskButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TAP TO TALK" />

        </LinearLayout>

        <Button
            android:id="@+id/voiceReplyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHONE VOICE REPLIES: ON" />

        <TextView
            android:id="@+id/jarvisReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="100dp"
            android:background="#0B1B27"
            android:padding="14dp"
            android:text="JARVIS replies will appear here."
            android:textColor="#D9F7FF"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PHONE ACCESS"
            android:textColor="#8FEFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Calendar, contacts, calling, WhatsApp, microphone and call-history functions remain on the Samsung. V30 routes them through JARVIS Cloud."
            android:textColor="#7895A5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STOP CLOUD LINK" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#0B1B27"
            android:padding="14dp"
            android:text="Not paired with JARVIS Cloud."
            android:textColor="#A8DCE8"
            android:textIsSelectable="true" />

    </LinearLayout>

</ScrollView>
