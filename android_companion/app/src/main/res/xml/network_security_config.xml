<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No HTTP fallback. The companion talks to Tailscale Serve over HTTPS only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
