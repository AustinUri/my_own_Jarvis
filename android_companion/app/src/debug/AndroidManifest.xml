<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <application>

        <!-- Legacy connection screen remains available only through
             Advanced diagnostics inside JARVIS. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            tools:node="replace" />

        <!-- One normal JARVIS launcher. -->
        <activity
            android:name=".JarvisHomeActivity"
            android:exported="true"
            android:label="JARVIS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- JARVIS-owned contact editor. -->
        <activity
            android:name=".JarvisContactEditorActivity"
            android:exported="false"
            android:label="JARVIS Contact" />

    </application>

</manifest>
